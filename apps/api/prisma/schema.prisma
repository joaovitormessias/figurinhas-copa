datasource db {
  provider = "postgresql"
  schemas  = ["figurinhas"]
}

generator client {
  provider = "prisma-client-js"
}

enum AdminStockStatus {
  available
  reserved
  unavailable
  out_of_stock

  @@schema("figurinhas")
}

enum PurchaseOrderStatus {
  pending_admin_approval
  approved
  rejected
  cancelled_by_user
  cancelled_by_admin
  expired
  completed

  @@schema("figurinhas")
}

enum ReservationStatus {
  active
  released
  expired
  converted_to_sale

  @@schema("figurinhas")
}

model StickerCatalog {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String              @unique @db.VarChar(50)
  albumNumber        Int                 @map("album_number")
  playerName         String              @map("player_name") @db.VarChar(120)
  teamName           String              @map("team_name") @db.VarChar(120)
  category           String              @db.VarChar(80)
  collection         String              @db.VarChar(120)
  imageUrl           String?             @map("image_url") @db.Text
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  adminStocks        AdminStock[]
  purchaseOrderItems PurchaseOrderItem[]
  reservations       Reservation[]

  @@map("sticker_catalog")
  @@schema("figurinhas")
}

model AdminStock {
  id               String              @id @default(uuid()) @db.Uuid
  stickerId        String              @map("sticker_id") @db.Uuid
  sticker          StickerCatalog      @relation(fields: [stickerId], references: [id])
  quantity         Int                 @default(0)
  reservedQuantity Int                 @default(0) @map("reserved_quantity")
  salePrice        Decimal             @map("sale_price") @db.Decimal(10, 2)
  isVisible        Boolean             @default(true) @map("is_visible")
  status           AdminStockStatus    @default(available)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  orderItems       PurchaseOrderItem[]
  reservations     Reservation[]

  @@index([stickerId])
  @@map("admin_stock")
  @@schema("figurinhas")
}

model PurchaseOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  status             PurchaseOrderStatus @default(pending_admin_approval)
  totalAmount        Decimal             @map("total_amount") @db.Decimal(10, 2)
  expiresAt          DateTime            @map("expires_at")
  adminDecisionAt    DateTime?           @map("admin_decision_at")
  completedAt        DateTime?           @map("completed_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  cancellationReason String?             @map("cancellation_reason") @db.Text
  userNote           String?             @map("user_note") @db.Text
  adminNote          String?             @map("admin_note") @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  items              PurchaseOrderItem[]
  reservations       Reservation[]

  @@index([userId])
  @@index([status])
  @@map("purchase_order")
  @@schema("figurinhas")
}

model PurchaseOrderItem {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  order        PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stickerId    String         @map("sticker_id") @db.Uuid
  sticker      StickerCatalog @relation(fields: [stickerId], references: [id])
  adminStockId String         @map("admin_stock_id") @db.Uuid
  adminStock   AdminStock     @relation(fields: [adminStockId], references: [id])
  quantity     Int
  unitPrice    Decimal        @map("unit_price") @db.Decimal(10, 2)
  subtotal     Decimal        @db.Decimal(10, 2)
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([orderId])
  @@index([stickerId])
  @@index([adminStockId])
  @@map("purchase_order_item")
  @@schema("figurinhas")
}

model Reservation {
  id           String            @id @default(uuid()) @db.Uuid
  orderId      String            @map("order_id") @db.Uuid
  order        PurchaseOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminStockId String            @map("admin_stock_id") @db.Uuid
  adminStock   AdminStock        @relation(fields: [adminStockId], references: [id])
  stickerId    String            @map("sticker_id") @db.Uuid
  sticker      StickerCatalog    @relation(fields: [stickerId], references: [id])
  quantity     Int
  status       ReservationStatus @default(active)
  expiresAt    DateTime          @map("expires_at")
  releasedAt   DateTime?         @map("released_at")
  convertedAt  DateTime?         @map("converted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([adminStockId])
  @@index([stickerId])
  @@index([status])
  @@map("reservation")
  @@schema("figurinhas")
}
