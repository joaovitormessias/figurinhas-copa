datasource db {
  provider = "postgresql"
  schemas  = ["figurinhas"]
}

generator client {
  provider = "prisma-client-js"
}

model StickerCatalog {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  albumNumber Int      @map("album_number")
  playerName  String   @map("player_name") @db.VarChar(120)
  teamName    String   @map("team_name") @db.VarChar(120)
  category    String   @db.VarChar(80)
  collection  String   @db.VarChar(120)
  imageUrl    String?  @map("image_url") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sticker_catalog")
  @@schema("figurinhas")
}
